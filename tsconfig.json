{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/types/*": [
        "./types/*"
      ],
      "@/app/*": [
        "./app/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ds-ref",
    "filebox",
    "filebox-m365",
    "deepseek-free-api",
    "deepseek-free-api-vercel",
    "ollama-explorer",
    "opencode",
    "opencode_fixed",
    "opencode_project",
    "opencode_repo",
    "opencode_upstream",
    "pay-page",
    "flyingmouse-format",
    "game-deploy",
    "id-card-checker",
    "AI-App-Generator",
    "CUsersAdministratorDocumentsDefault Projecttiantian-navigation",
    "tiantian-navigation"
  ]
}
