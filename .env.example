# Casdoor Configuration
CASDOOR_ORG_NAME=ds4-org
CASDOOR_APP_NAME=ds4-platform
CASDOOR_CLIENT_ID=your-casdoor-client-id
CASDOOR_CLIENT_SECRET=your-casdoor-client-secret
CASDOOR_REDIRECT_URI=http://localhost:3000/callback
CASDOOR_API_URL=https://casdoor.example.com

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# DaxPay Configuration
DAXPAY_API_URL=http://localhost:8080
DAXPAY_APP_ID=your-daxpay-app-id
DAXPAY_SECRET_KEY=your-daxpay-secret-key

# Admin API Key (used by the admin dashboard to save payment config)
ADMIN_API_KEY=change-me-to-a-long-random-string

# Public app URL (used in payment notify callbacks)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# OpenAI Compatible API Configuration
API_KEY_PREFIX=sk-ds4-

# Default Models
DEFAULT_MODELS=llama-3-70b,qwen-72b,deepseek-coder
